# Attest - Environment Variables

# Server
PORT=3001
NODE_ENV=development

# Session (REQUIRED - generate with: openssl rand -base64 48)
SESSION_SECRET=your-super-secret-session-key-minimum-32-characters

# ═══════════════════════════════════════════════════════════════
# EMAIL CONFIGURATION (choose one option)
# ═══════════════════════════════════════════════════════════════

# Option 1: Resend API (RECOMMENDED for production)
# Sign up at https://resend.com and get API key
RESEND_API_KEY=re_YOUR_API_KEY
RESEND_FROM=Attest <noreply@yourdomain.com>

# Option 2: SMTP (Gmail, SendGrid, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Option 3: None (OTPs logged to console - dev mode only)

# ═══════════════════════════════════════════════════════════════

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Production only
# COOKIE_DOMAIN=yourdomain.com

# Database
DATABASE_PATH=./data/attest.db
